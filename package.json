{
  "name": "my-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:android": "vue-tsc -b && cross-env CAPACITOR_BUILD=true VITE_CAPACITOR_BUILD=true VITE_API_URL=https://nikitaredko.ru vite build",
    "build:local": "npm run build && npm run copy:dist",
    "copy:dist": "node scripts/copy-dist.mjs",
    "clean": "node scripts/clean.mjs",
    "cap:sync": "npm run build:android && npx cap sync android",
    "cap:open": "npx cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@giscus/vue": "^3.1.1",
    "@unhead/vue": "^3.4.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.1",
    "markdown-it-container": "^4.0.0",
    "nanoid": "^3.3.19",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.6",
    "cross-env": "^10.1.0",
    "git-rev-sync": "^3.0.2",
    "happy-dom": "^20.14.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
