# Nikita Redko Personal Site — Backend Configuration
# ИНСТРУКЦИЯ:
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни значения своими данными
# 3. Файл .env НЕ должен попадать в git (уже в .gitignore)

# Outline CMS

# Базовый URL вашего Outline-инстанса (без слэша на конце)
OUTLINE_API_URL=https://your-outline-instance.example.com

# API-ключ для доступа к Outline
# Получить: Настройки → API и приложения → Новый API-ключ
# ⚠️  Не указывай область видимости (scope) — ключ должен иметь полный доступ
OUTLINE_API_KEY=ol_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Разрешённые коллекции (через запятую). Статьи из других коллекций не попадут на сайт.
# Если переменная пустая или отсутствует — разрешены ВСЕ коллекции.
OUTLINE_ALLOWED_COLLECTIONS=Гайды,Новости,Мысли

# Секрет для вебхуков от Outline (используется для инвалидации кэша)
# Получить: Настройки → Вебхуки → Новый вебхук
# URL вебхука: https://your-domain.com/api/webhook/outline
# Рекомендуемые события: "Все события document", "Все события collection"
OUTLINE_WEBHOOK_SECRET=your-webhook-secret-here

# ID документов со статическими страницами (опционально)
# Если не указаны — бэкенд попытается найти документы по заголовку ("About" / "Uses")
# ID можно скопировать из URL документа в Outline
ABOUT_DOCUMENT_ID=00000000-0000-0000-0000-000000000000
USES_DOCUMENT_ID=00000000-0000-0000-0000-000000000000

# Cache

# Время жизни кэша в минутах. Значение 0 полностью отключает кэш.
CACHE_TTL_MINUTES=30

# RSS & SEO

# Метаданные сайта, используются в RSS-ленте и SEO-инъекциях
SITE_TITLE=Nikita Redko — Блог
SITE_DESCRIPTION=Статьи о разработке, проектах и мыслях вслух

# Server & HTTP

# Порт, на котором слушает бэкенд
PORT=8080

# Домены, с которых разрешены CORS-запросы (через запятую)
# https://localhost — origin WebView Capacitor-приложения (APK)
ALLOW_CORS=http://localhost:5173,http://localhost:3000,https://localhost,https://your-domain.com

# IP-адреса доверенных прокси (Nginx, Cloudflare и т.п.)
# Нужно для корректного определения реального IP клиента и схемы (http/https)
TRUSTED_PROXIES=127.0.0.1

# Раздавать ли собранную статику из ./dist через Go-сервер
# true  → бэкенд сам отдаёт фронтенд (удобно для single-binary деплоя)
# false → только API, фронтенд раздаётся Nginx/CDN
SERVE_STATIC=true


# Runtime

# Режим работы Gin: "debug" или "release"
# В release отключаются debug-логи и проверяется отсутствие уязвимых маршрутов
# Альтернативный способ включить production-режим (устаревший, но поддерживается)
GIN_MODE=release